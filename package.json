{
  "name": "trust-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Trust v1: agent memory that knows where every memory came from. Demo + backend on Cloudflare.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node test/e2e.mjs",
    "test:unit": "esbuild src/judge.ts --format=esm --outfile=.build/judge.mjs --log-level=warning && node test/judge.test.mjs",
    "eval": "node eval/score.mjs",
    "dev:offline": "node scripts/offline-config.mjs && wrangler dev -c .wrangler.offline.jsonc",
    "ci": "npm run typecheck && npm run test:unit && bash scripts/ci.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
