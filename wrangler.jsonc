{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trust",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Static site: the landing page at /, the interactive demo at /demo/. /api/* and /mcp/* go to the
  // Worker, and so does /new: TRUST_DISABLE_NEW=1 answers 404 there, and otherwise the Worker hands
  // the request to the static site, which serves the same page as before.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/mcp/*", "/auth/*", "/new", "/new/*"] },
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "SCOPE", "class_name": "Scope" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Registry", "Scope"] }],
  // Workers AI: the memory judge uses Clef-Flash through this binding when deployed.
  // Choose the judge with TRUST_JUDGE (auto | heuristic | workers-ai | systemone); see README.
  // This binding makes `wrangler dev` open a remote session (needs a Cloudflare login).
  // `npm run dev:offline` runs without it and falls back to the heuristic judge.
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
